datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  leaderName  String
  phone       String
  location    String
  schedule    String
  description String?
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fullName  String
  memberNo  String?  @unique
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventType {
  INTERNAL
  EXTERNAL
}

model Event {
  id              String    @id @default(uuid())
  title           String
  type            EventType @default(INTERNAL)
  eventDate       DateTime
  location        String
  description     String?
  pdfUrl          String?
  registrationUrl String?
  status          String    @default("UPCOMING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum MediaType {
  PHOTO
  VIDEO
}

model Gallery {
  id          String    @id @default(uuid())
  title       String
  category    String
  mediaType   MediaType @default(PHOTO)
  mediaUrl    String?
  youtubeUrl  String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  category     String
  content      String   @db.Text
  thumbnailUrl String?
  author       String   @default("Admin FESPATI")
  isPublished  Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
