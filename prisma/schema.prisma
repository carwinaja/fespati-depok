datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel-openssl-3.0.x = runtime Vercel
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN") // SUPER_ADMIN | ADMIN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  leaderName  String
  phone       String
  location    String
  schedule    String
  description String?
  mapUrl      String?
  colorHex    String?
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fullName  String
  memberNo  String?  @unique
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

enum EventType {
  INTERNAL
  EXTERNAL
}

model Event {
  id              String    @id @default(uuid())
  title           String
  type            EventType @default(INTERNAL)
  eventDate       DateTime
  location        String
  description     String?
  pdfUrl          String?
  registrationUrl String?
  status          String    @default("UPCOMING")
  galleries       Gallery[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([eventDate])
}

enum MediaType {
  PHOTO
  VIDEO
}

model Gallery {
  id          String    @id @default(uuid())
  title       String
  category    String
  mediaType   MediaType @default(PHOTO)
  mediaUrl    String?
  youtubeUrl  String?
  description String?
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventId])
}

model Article {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  category     String
  excerpt      String?
  content      String   @db.Text
  thumbnailUrl String?
  author       String   @default("Admin FESPATI")
  isPublished  Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
}

model HeroSlide {
  id        String   @id @default(uuid())
  imageUrl  String
  alt       String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
